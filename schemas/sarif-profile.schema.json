{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gatekeeper.africa/schemas/sarif-profile/v1.json",
  "title": "Gate-Keeper SARIF 2.1.0 profile",
  "description": "The closed SARIF 2.1.0 profile written by one Gate-Keeper scan. The identifier is a name only; it does not need to resolve. A log that adds a snippet, a machine path or a help URI is not this profile.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json"
    },
    "version": { "const": "2.1.0" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "required": ["$schema", "version", "runs"],
  "additionalProperties": false,
  "$defs": {
    "civilDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pack": {
      "oneOf": [
        { "$ref": "#/$defs/invenioPack" },
        { "$ref": "#/$defs/localPack" }
      ]
    },
    "invenioPack": {
      "type": "object",
      "properties": {
        "packId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]+$" },
        "provenance": { "enum": ["bundled", "plan-gated"] },
        "coverageDate": { "$ref": "#/$defs/civilDate" },
        "contentDigest": { "$ref": "#/$defs/hex64" }
      },
      "required": ["packId", "version", "provenance", "coverageDate", "contentDigest"],
      "additionalProperties": false
    },
    "localPack": {
      "type": "object",
      "properties": {
        "packId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "provenance": { "const": "local" },
        "contentDigest": { "$ref": "#/$defs/hex64" }
      },
      "required": ["packId", "version", "provenance", "contentDigest"],
      "additionalProperties": false
    },

    "run": {
      "type": "object",
      "properties": {
        "tool": { "$ref": "#/$defs/tool" },
        "invocations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/invocation" }
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        },
        "properties": { "$ref": "#/$defs/runProperties" }
      },
      "required": ["tool", "invocations", "results", "properties"],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "driver": { "$ref": "#/$defs/driver" }
      },
      "required": ["driver"],
      "additionalProperties": false
    },
    "driver": {
      "type": "object",
      "properties": {
        "name": { "const": "gatekeeper" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "informationUri": { "const": "https://gatekeeper.africa/" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      },
      "required": ["name", "version", "informationUri", "rules"],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$" },
        "shortDescription": { "$ref": "#/$defs/message" },
        "properties": { "$ref": "#/$defs/citationProperties" }
      },
      "required": ["id", "shortDescription"],
      "additionalProperties": false
    },
    "citationProperties": {
      "type": "object",
      "properties": {
        "gaid": { "type": "string", "minLength": 1 },
        "ndpa": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "properties": {
        "executionSuccessful": { "const": true },
        "exitCode": { "enum": [0, 1] },
        "toolExecutionNotifications": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/notification" }
        }
      },
      "required": ["executionSuccessful", "exitCode"],
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "properties": {
        "level": { "const": "warning" },
        "message": { "$ref": "#/$defs/message" }
      },
      "required": ["level", "message"],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "ruleIndex": { "type": "integer", "minimum": 0 },
        "level": { "enum": ["error", "warning", "note"] },
        "message": { "$ref": "#/$defs/message" },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/location" }
        },
        "baselineState": { "enum": ["unchanged", "new"] },
        "partialFingerprints": { "$ref": "#/$defs/fingerprints" }
      },
      "required": ["ruleId", "ruleIndex", "level", "message", "locations", "baselineState"],
      "additionalProperties": false
    },
    "fingerprints": {
      "type": "object",
      "properties": {
        "gatekeeper/v1": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["gatekeeper/v1"],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "physicalLocation": { "$ref": "#/$defs/physicalLocation" }
      },
      "required": ["physicalLocation"],
      "additionalProperties": false
    },
    "physicalLocation": {
      "type": "object",
      "properties": {
        "artifactLocation": { "$ref": "#/$defs/artifactLocation" },
        "region": { "$ref": "#/$defs/region" }
      },
      "required": ["artifactLocation", "region"],
      "additionalProperties": false
    },
    "artifactLocation": {
      "type": "object",
      "properties": {
        "uri": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]*$" }
      },
      "required": ["uri"],
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 }
      },
      "required": ["startLine", "startColumn"],
      "additionalProperties": false
    },
    "runProperties": {
      "type": "object",
      "properties": {
        "evaluatedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "historyScanned": { "type": "boolean" },
        "packs": {
          "$comment": "New producers always emit the loaded-pack stamps. Optional for logs from schema artefact versions before 1.2.0.",
          "type": "array",
          "items": { "$ref": "#/$defs/pack" }
        },
        "profile": { "enum": ["default", "deep"] },
        "repositoryId": { "type": "string", "maxLength": 200 }
      },
      "required": ["evaluatedOn", "historyScanned", "profile", "repositoryId"],
      "additionalProperties": false
    }
  }
}
