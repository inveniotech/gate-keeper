<Project>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Test-only JSON Schema validator, approved under rule 8 on 1 November 2026 (P0-03). It is not referenced by cli/ or src/Engine. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
  </ItemGroup>

  <!--
    Packages evaluated by the NativeAOT feasibility spike (P0-16).
    BouncyCastle.Cryptography is also referenced by the licence-vector tests
    (P0-06). Tomlyn, SarifKit and Rebex stay on the spike projects.
    BouncyCastle.Cryptography, Tomlyn and SarifKit are already approved in
    AGENTS.md rule 8; Rebex is the pre-approved fallback recorded against IQ-11.
  -->
  <ItemGroup>
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="Rebex.Elliptic.Ed25519" Version="1.2.2" />
    <PackageVersion Include="SarifKit" Version="1.0.0" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
</Project>
