<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>InvenioTech.GateKeeper.Engine.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Already approved in AGENTS.md rule 8 by the owner on 3 November 2026. Test-only: the assertion library for this project. Not referenced by cli/ or src/Engine. -->
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\InvenioTech.GateKeeper.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the development pack vectors into the test output so PackLoaderTests consumes the real committed files; the easy way to regenerate them is New-PackVectors.mjs. -->
    <None Include="..\..\tests\vectors\pack\*.pack.json" Link="vectors\pack\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\vectors\pack\*.manifest.armour" Link="vectors\pack\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\vectors\pack\*.signature.hex" Link="vectors\pack\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\vectors\pack\development-public-key.json" Link="vectors\pack\development-public-key.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ci\native-release\reference.pack.json" Link="benchmark/reference.pack.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\vectors\matcher\vectors.json" Link="vectors\matcher\vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
